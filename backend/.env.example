# Rename this file to ".env" and fill in your own values

# Port your backend server will run on
PORT=5000

# Your MongoDB connection string
# Local MongoDB example:
MONGO_URI=mongodb://127.0.0.1:27017/blogapp
# OR MongoDB Atlas (cloud) example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/blogapp

# Secret key used to sign JWT tokens (use any long random string)
JWT_SECRET=this_is_a_super_secret_key_change_it
